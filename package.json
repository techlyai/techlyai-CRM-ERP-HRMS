{
  "name": "techly-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-ts.cjs tests/run.ts",
    "create-admin": "node --env-file-if-exists=.env.local scripts/run-ts.cjs scripts/create-admin.ts",
    "seed:dev-accounts": "node --env-file-if-exists=.env.local scripts/run-ts.cjs scripts/seed-dev-accounts.ts",
    "db:verify": "node --env-file=.env.database scripts/run-ts.cjs scripts/verify-database.ts",
    "db:contracts": "node scripts/run-ts.cjs scripts/generate-contracts.ts",
    "db:start": "powershell -NoProfile -File scripts/local-postgres.ps1 start",
    "db:stop": "powershell -NoProfile -File scripts/local-postgres.ps1 stop",
    "db:setup": "node --env-file-if-exists=.env.database scripts/run-ts.cjs scripts/setup-database.ts",
    "db:docker:prepare": "powershell -NoProfile -File scripts/docker-postgres.ps1 prepare",
    "db:docker:start": "powershell -NoProfile -File scripts/docker-postgres.ps1 start",
    "db:docker:stop": "powershell -NoProfile -File scripts/docker-postgres.ps1 stop",
    "db:docker:status": "powershell -NoProfile -File scripts/docker-postgres.ps1 status"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.8.1",
    "fflate": "0.8.2",
    "framer-motion": "11.18.2",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
