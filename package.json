{
  "name": "techly-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-ts.cjs tests/run.ts",
    "create-admin": "node --env-file-if-exists=.env.local scripts/run-ts.cjs scripts/create-admin.ts",
    "db:setup": "node --env-file-if-exists=.env.database scripts/run-ts.cjs scripts/setup-database.ts",
    "db:verify": "node --env-file-if-exists=.env.database scripts/run-ts.cjs scripts/verify-database.ts",
    "db:contracts": "node scripts/run-ts.cjs scripts/generate-contracts.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "web-push": "3.6.7",
    "docx": "9.8.1",
    "fflate": "0.8.2",
    "jspdf": "4.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/web-push": "3.6.4",
    "tailwindcss": "3.4.18",
    "postcss": "8.5.6",
    "autoprefixer": "10.4.21",
    "prettier": "3.6.2",
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
