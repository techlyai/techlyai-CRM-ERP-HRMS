# Dokploy backend environment. Use different random 64-character hex secrets.
# Passwords are interpolated into URLs; use hex (no reserved URL characters).
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
TECHLY_INTERNAL_API_KEY=
CRON_SECRET=
# Frontend origin, even in the backend environment:
APP_URL=https://crm.example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# For running outside Docker, additionally set the restricted connection:
DATABASE_URL=
DATABASE_ADMIN_URL=
