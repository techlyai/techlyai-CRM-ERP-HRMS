# Dokploy: deploy only backend with ./docker-compose.yml.
# Use three different random 64-character hexadecimal secrets.
APP_URL=https://your-techly-domain.example
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
CRON_SECRET=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Local development only: db:setup writes DATABASE_URL into .env.local.
# Compose constructs both database URLs internally; omit these in Dokploy.
DATABASE_URL=
DATABASE_ADMIN_URL=

# Optional: PostgreSQL connection pool size per server process (default 10).
DATABASE_POOL_SIZE=
