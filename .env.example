# Dokploy: deploy only backend with ./docker-compose.yml.
# Use three different random 64-character hexadecimal secrets.
APP_URL=https://your-techly-domain.example
POSTGRES_PASSWORD=
DATABASE_APP_PASSWORD=
CRON_SECRET=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Local development only: db:setup writes DATABASE_URL into .env.local.
# Compose constructs both database URLs internally; omit these in Dokploy.
DATABASE_URL=
DATABASE_ADMIN_URL=

# Optional: PostgreSQL connection pool size per server process (default 10).
DATABASE_POOL_SIZE=

# Email delivery (Resend). Sender identity and templates are configured in Settings → Email.
RESEND_API_KEY=

# Client credentials vault: 32 random bytes (64 hex characters). Keep it secret and backed up;
# without it stored passwords cannot be decrypted. After rotating, list old keys in
# CREDENTIALS_PREVIOUS_KEYS (comma separated) so earlier passwords stay readable.
CREDENTIALS_ENCRYPTION_KEY=
CREDENTIALS_PREVIOUS_KEYS=

# Optional ceiling for employee joining-document PDFs, in MB. Leave empty for no limit
# (disk space and database backups then become the practical limit).
MAX_JOINING_DOCUMENT_MB=

# Optional: set to "openstreetmap" to show map tiles for office, attendance and field locations.
# Embedding sends those coordinates to openstreetmap.org when a page is viewed; when empty,
# reviewers get a link they choose to open instead. No API key is needed. Build-time value.
NEXT_PUBLIC_ATTENDANCE_MAP=

# Development/test accounts only (npm run seed:dev-accounts). Leave both empty in production.
# DEV_ACCOUNT_PASSWORD overrides the default local password used by the seed.
# ALLOW_DEV_ACCOUNTS=true lets seeded weak-password accounts sign in when NODE_ENV=production;
# set it only on an isolated test deployment.
DEV_ACCOUNT_PASSWORD=
ALLOW_DEV_ACCOUNTS=
